<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd plist for Outreach Recruitment Job Sync Agent
  Runs every day at 07:00 Malta time (launchd uses the Mac's local clock, Europe/Paris = Malta).
  The open/close report email is held until 09:00.

  Install:
    cp tools/net.outreachrecruitment.job-sync.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/net.outreachrecruitment.job-sync.plist

  To run manually now:
    launchctl start net.outreachrecruitment.job-sync

  To uninstall:
    launchctl unload ~/Library/LaunchAgents/net.outreachrecruitment.job-sync.plist
    rm ~/Library/LaunchAgents/net.outreachrecruitment.job-sync.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.outreachrecruitment.job-sync</string>

  <!-- Launch with /bin/bash directly: macOS privacy (TCC) blocks ~/Documents for other
       launchers — wrapping it in /usr/bin/caffeinate failed every run with "Operation not
       permitted" (2026-10-13/14). run_sync_agent.sh starts caffeinate itself. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/sof/Documents/Projects/OutreachRecruitmentwebsite/OutreachRecruitment-Jobs-in-Malta/tools/run_sync_agent.sh</string>
  </array>

  <!-- Every hour 07:00–20:00 (Malta time); the script runs the sync once a day — the first hour the Mac is on. Email at 09:00 or straight after a later run. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/sof/Documents/Projects/OutreachRecruitmentwebsite/OutreachRecruitment-Jobs-in-Malta/reports/logs/launchd-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sof/Documents/Projects/OutreachRecruitmentwebsite/OutreachRecruitment-Jobs-in-Malta/reports/logs/launchd-stderr.log</string>

  <!-- Also at login / after a restart: the script itself skips if today's report already exists. -->
  <key>RunAtLoad</key>
  <true/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/sof/.local/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
