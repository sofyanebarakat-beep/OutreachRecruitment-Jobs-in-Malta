DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect .html extension to clean URL (301 permanent)
    RewriteCond %{THE_REQUEST} \s/(.+)\.html[\s?]
    RewriteRule ^ /%1 [R=301,L]

    # Serve sector pages clean URLs directly
    RewriteRule ^marine-jobs-in-malta/?$ marine-jobs-in-malta.html [L]

    # Serve new Study in Malta article clean URL directly
    RewriteRule ^study-in-malta-from-morocco/?$ study-in-malta-from-morocco/index.html [L]
    RewriteRule ^study-in-malta-from-india/?$ study-in-malta-from-india/index.html [L]

    # Redirect dead pages from the previous site (still indexed by Google as of 2026-07)
    # to their closest current equivalent, so old backlinks/search results aren't 404s.
    RewriteRule ^gbs-malta/?$ /study-in-malta [R=301,L]
    RewriteRule ^tourism-hospitality/?$ /study-in-malta [R=301,L]
    RewriteRule ^study-english-in-malta-3/?$ /study-in-malta [R=301,L]
    RewriteRule ^information-technology-courses/?$ /study-in-malta [R=301,L]
    RewriteRule ^courses/master-of-business-administration/?$ /study-in-malta [R=301,L]
    RewriteRule ^free-webinar-study-and-eventually-work-in-malta/?$ /webinar-study-in-malta [R=301,L]

    # Serve sitemap XML files directly with correct MIME type
    RewriteRule ^sitemaps/.*\.xml$ - [L,T=text/xml]
    RewriteRule ^sitemap.*\.xml$ - [L,T=text/xml]

    # Serve real files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else through our static site router
    RewriteRule ^ site-router.php [L]
</IfModule>
